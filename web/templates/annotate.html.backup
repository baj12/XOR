{% extends "base.html" %}

{% block title %}Annotate Recording - Recording Management System{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-pencil-square"></i> Annotate Recording</h2>
            <p class="text-muted">Add metadata to recordings before processing</p>
        </div>
    </div>

    <div class="row">
        <!-- Recording Selection -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-list-ul"></i> Available Recordings
                    <button class="btn btn-sm btn-outline-primary float-end" onclick="refreshRubix44List()">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
                <div class="card-body" id="rubix44-list-container">
                    <!-- Populated by JavaScript -->
                </div>
            </div>

            <!-- Start New Recording -->
            <div class="card mt-4">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-record-circle"></i> Start New Recording
                </div>
                <div class="card-body">
                    <form id="start-recording-form">
                        <div class="mb-3">
                            <label class="form-label">Playback File</label>
                            <select class="form-select" id="playback-file" required>
                                <option value="">Select playback file...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Duration (seconds)</label>
                            <input type="number" class="form-control" id="duration" value="60" min="1" max="7200" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Output Prefix</label>
                            <input type="text" class="form-control" id="output-prefix" value="recording" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success" id="start-recording-btn">
                                <i class="bi bi-record-circle-fill"></i> Start Recording
                            </button>
                        </div>
                    </form>
                    <div id="recording-status" class="mt-3" style="display:none;">
                        <!-- Recording status shown here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Annotation Form -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-clipboard-data"></i> Metadata Form
                    <span id="selected-session-id" class="badge bg-secondary float-end">No recording selected</span>
                </div>
                <div class="card-body">
                    <form id="annotation-form">
                        <input type="hidden" id="session_id" name="session_id">

                        <!-- Session Info (Read-only) -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Recording Date</label>
                                <input type="text" class="form-control" id="recording_date" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Duration (seconds)</label>
                                <input type="text" class="form-control" id="duration_seconds" readonly>
                            </div>
                        </div>

                        <!-- Channel Configuration -->
                        <h5 class="mb-3"><i class="bi bi-hdd-network"></i> Channel Configuration</h5>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label">Channel 1 (Left) Source</label>
                                        <input type="text" class="form-control" id="channel_1_source"
                                               placeholder="e.g., Beaker_A, Lavender, Instrument_1" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Expected Class</label>
                                        <select class="form-select" id="channel_1_expected_class" required>
                                            <option value="">Select...</option>
                                            <option value="0">0 - Negative</option>
                                            <option value="1">1 - Positive</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-8">
                                        <label class="form-label">Channel 2 (Right) Source</label>
                                        <input type="text" class="form-control" id="channel_2_source"
                                               placeholder="e.g., Beaker_B, Empty, Instrument_2" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Expected Class</label>
                                        <select class="form-select" id="channel_2_expected_class" required>
                                            <option value="">Select...</option>
                                            <option value="0">0 - Negative</option>
                                            <option value="1">1 - Positive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Beaker Setup -->
                        <h5 class="mb-3"><i class="bi bi-cup"></i> Beaker Setup (3 Beakers)</h5>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Beaker 1 Role</label>
                                        <select class="form-select" id="beaker_1_role" required>
                                            <option value="not_used">Not Used</option>
                                            <option value="recording">Recording</option>
                                            <option value="instrument">Instrument</option>
                                            <option value="empty">Empty</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">Beaker 1 Content</label>
                                        <input type="text" class="form-control" id="beaker_1_content"
                                               placeholder="e.g., Lavender, Empty, Noise source">
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Beaker 2 Role</label>
                                        <select class="form-select" id="beaker_2_role" required>
                                            <option value="not_used">Not Used</option>
                                            <option value="recording">Recording</option>
                                            <option value="instrument">Instrument</option>
                                            <option value="empty">Empty</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">Beaker 2 Content</label>
                                        <input type="text" class="form-control" id="beaker_2_content">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">Beaker 3 Role</label>
                                        <select class="form-select" id="beaker_3_role" required>
                                            <option value="not_used">Not Used</option>
                                            <option value="recording">Recording</option>
                                            <option value="instrument">Instrument</option>
                                            <option value="empty">Empty</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">Beaker 3 Content</label>
                                        <input type="text" class="form-control" id="beaker_3_content">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Experimental Conditions -->
                        <h5 class="mb-3"><i class="bi bi-gear"></i> Experimental Conditions</h5>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="faraday_cage_used">
                                            <label class="form-check-label" for="faraday_cage_used">
                                                <strong>Faraday Cage Used</strong>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Experiment ID</label>
                                        <select class="form-select" id="experiment_id" required>
                                            <option value="">Select or type new...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Researcher Name</label>
                                        <input type="text" class="form-control" id="researcher_name"
                                               value="Bernd" required>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <label class="form-label">Experiment Description</label>
                                        <textarea class="form-control" id="experiment_description" rows="2"
                                                  placeholder="Brief description of what you're testing..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Weather & Comments -->
                        <h5 class="mb-3"><i class="bi bi-cloud-sun"></i> Weather & Notes</h5>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <button type="button" class="btn btn-outline-secondary" onclick="fetchWeather()">
                                            <i class="bi bi-cloud-download"></i> Fetch Current Weather (Viroflay)
                                        </button>
                                        <div id="weather-display" class="mt-2" style="display:none;">
                                            <!-- Weather info displayed here -->
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <label class="form-label">Comments & Notes</label>
                                        <textarea class="form-control" id="comments" rows="3"
                                                  placeholder="Any observations, issues, or notes about this recording..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-outline-secondary" onclick="clearForm()">
                                <i class="bi bi-x-circle"></i> Clear Form
                            </button>
                            <button type="submit" class="btn btn-primary" id="save-metadata-btn">
                                <i class="bi bi-save"></i> Save Metadata
                            </button>
                            <button type="button" class="btn btn-success" onclick="saveAndMarkComplete()" id="save-complete-btn">
                                <i class="bi bi-check-circle"></i> Save & Mark Complete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
let selectedSessionId = null;
let weatherData = null;

// Load rubix44 recordings on page load
document.addEventListener('DOMContentLoaded', async function() {
    await loadExperiments();
    await loadPlaybackFiles();
    await refreshRubix44List();
    checkRecordingStatus();
    setInterval(checkRecordingStatus, 5000); // Check every 5 seconds
});

async function loadExperiments() {
    try {
        const response = await fetch('/api/experiments');
        const data = await response.json();

        const select = document.getElementById('experiment_id');
        data.experiments.forEach(exp => {
            const option = document.createElement('option');
            option.value = exp.experiment_id;
            option.textContent = `${exp.experiment_id} - ${exp.experiment_name}`;
            select.appendChild(option);
        });

        // Make it editable
        select.setAttribute('list', 'experiment-datalist');
    } catch (error) {
        console.error('Failed to load experiments:', error);
    }
}

async function loadPlaybackFiles() {
    try {
        const response = await fetch('/api/rubix44/playback-files');
        const data = await response.json();

        if (data.success) {
            const select = document.getElementById('playback-file');
            data.files.forEach(file => {
                const option = document.createElement('option');
                option.value = file.name;
                option.textContent = file.name;
                select.appendChild(option);
            });
        }
    } catch (error) {
        console.error('Failed to load playback files:', error);
    }
}

async function refreshRubix44List() {
    const container = document.getElementById('rubix44-list-container');
    showLoading('rubix44-list-container');

    try {
        const response = await fetch('/api/rubix44/recordings');
        const data = await response.json();

        if (data.success) {
            let html = '<div class="list-group list-group-flush">';

            if (data.recordings.length === 0) {
                html += '<div class="text-muted text-center p-3">No recordings found on Rubix44</div>';
            } else {
                data.recordings.forEach(rec => {
                    const stereoFile = rec.files.find(f => f.name.includes('_stereo.wav'));
                    const sizeKB = stereoFile ? (stereoFile.size / 1024).toFixed(0) : '?';

                    html += `
                        <a href="#" class="list-group-item list-group-item-action"
                           onclick="selectRecording('${rec.id}', event)">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1"><small>${rec.id}</small></h6>
                                <small class="text-muted">${sizeKB} KB</small>
                            </div>
                            <small class="text-muted">${rec.timestamp}</small>
                        </a>
                    `;
                });
            }

            html += '</div>';
            container.innerHTML = html;
        } else {
            showError('rubix44-list-container', 'Failed to load: ' + data.error);
        }
    } catch (error) {
        console.error('Failed to fetch rubix44 recordings:', error);
        showError('rubix44-list-container', 'Error connecting to Rubix44');
    }
}

async function selectRecording(sessionId, event) {
    if (event) event.preventDefault();

    selectedSessionId = sessionId;
    document.getElementById('session_id').value = sessionId;
    document.getElementById('selected-session-id').textContent = sessionId;

    // Try to load existing metadata
    try {
        const response = await fetch(`/api/recordings/${sessionId}`);
        const data = await response.json();

        if (data.success && data.recording) {
            // Populate form with existing data
            populateForm(data.recording);
            showAlert('Loaded existing metadata for ' + sessionId, 'info');
        } else {
            // New recording - set defaults
            document.getElementById('recording_date').value = sessionId.split('_').slice(1).join(' ');
            showAlert('Ready to annotate ' + sessionId, 'success');
        }
    } catch (error) {
        console.error('Error loading metadata:', error);
        document.getElementById('recording_date').value = sessionId.split('_').slice(1).join(' ');
    }
}

function populateForm(recording) {
    // Populate all form fields
    Object.keys(recording).forEach(key => {
        const element = document.getElementById(key);
        if (element) {
            if (element.type === 'checkbox') {
                element.checked = recording[key];
            } else {
                element.value = recording[key] || '';
            }
        }
    });
}

async function fetchWeather() {
    try {
        showAlert('Fetching weather data for Viroflay...', 'info');

        const response = await fetch('/api/weather');
        const data = await response.json();

        if (data.success) {
            weatherData = data.weather;

            const display = document.getElementById('weather-display');
            display.innerHTML = `
                <div class="alert alert-info">
                    <strong>Weather captured:</strong> ${data.summary}<br>
                    <small>Observed: ${formatDateTime(weatherData.weather_timestamp)}</small>
                </div>
            `;
            display.style.display = 'block';

            showAlert('Weather data fetched successfully!', 'success');
        } else {
            showAlert('Failed to fetch weather: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error fetching weather data', 'danger');
    }
}

document.getElementById('annotation-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    await saveMetadata(false);
});

async function saveAndMarkComplete() {
    await saveMetadata(true);
}

async function saveMetadata(markComplete) {
    if (!selectedSessionId) {
        showAlert('Please select a recording first', 'warning');
        return;
    }

    // Collect form data
    const formData = {
        session_id: selectedSessionId,
        recording_date: document.getElementById('recording_date').value,
        channel_1_source: document.getElementById('channel_1_source').value,
        channel_2_source: document.getElementById('channel_2_source').value,
        channel_1_expected_class: parseInt(document.getElementById('channel_1_expected_class').value),
        channel_2_expected_class: parseInt(document.getElementById('channel_2_expected_class').value),
        beaker_1_role: document.getElementById('beaker_1_role').value,
        beaker_1_content: document.getElementById('beaker_1_content').value,
        beaker_2_role: document.getElementById('beaker_2_role').value,
        beaker_2_content: document.getElementById('beaker_2_content').value,
        beaker_3_role: document.getElementById('beaker_3_role').value,
        beaker_3_content: document.getElementById('beaker_3_content').value,
        faraday_cage_used: document.getElementById('faraday_cage_used').checked,
        experiment_id: document.getElementById('experiment_id').value,
        researcher_name: document.getElementById('researcher_name').value,
        experiment_description: document.getElementById('experiment_description').value,
        comments: document.getElementById('comments').value,
        metadata_complete: markComplete
    };

    // Add weather data if fetched
    if (weatherData) {
        Object.assign(formData, weatherData);
    }

    try {
        const response = await fetch(`/api/recordings/${selectedSessionId}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
            const msg = markComplete ? 'Metadata saved and marked complete!' : 'Metadata saved!';
            showAlert(msg, 'success');

            if (markComplete) {
                // Clear form and refresh list
                setTimeout(() => {
                    clearForm();
                    refreshRubix44List();
                }, 1500);
            }
        } else {
            showAlert('Failed to save: ' + data.error, 'danger');
        }
    } catch (error) {
        console.error('Error saving metadata:', error);
        showAlert('Error saving metadata', 'danger');
    }
}

function clearForm() {
    document.getElementById('annotation-form').reset();
    selectedSessionId = null;
    weatherData = null;
    document.getElementById('selected-session-id').textContent = 'No recording selected';
    document.getElementById('weather-display').style.display = 'none';
}

// Start new recording
document.getElementById('start-recording-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const playbackFile = document.getElementById('playback-file').value;
    const duration = parseInt(document.getElementById('duration').value);
    const prefix = document.getElementById('output-prefix').value;

    try {
        document.getElementById('start-recording-btn').disabled = true;
        showAlert('Starting recording...', 'info');

        const response = await fetch('/api/rubix44/start', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                playback_file: playbackFile,
                duration: duration,
                output_prefix: prefix
            })
        });

        const data = await response.json();

        if (data.success) {
            showAlert(`Recording started! Session ID: ${data.session_id}`, 'success');
            document.getElementById('recording-status').style.display = 'block';
            document.getElementById('recording-status').innerHTML = `
                <div class="alert alert-success">
                    <strong>Recording in progress...</strong><br>
                    Session: ${data.session_id}<br>
                    Duration: ${duration}s
                </div>
            `;
        } else {
            showAlert('Failed to start recording: ' + data.error, 'danger');
            document.getElementById('start-recording-btn').disabled = false;
        }
    } catch (error) {
        showAlert('Error starting recording', 'danger');
        document.getElementById('start-recording-btn').disabled = false;
    }
});

async function checkRecordingStatus() {
    try {
        const response = await fetch('/api/rubix44/status');
        const data = await response.json();

        if (data.status === 'recording') {
            document.getElementById('start-recording-btn').disabled = true;
            document.getElementById('recording-status').style.display = 'block';
            document.getElementById('recording-status').innerHTML = `
                <div class="alert alert-warning">
                    <strong>Recording in progress...</strong><br>
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Please wait...
                </div>
            `;
        } else {
            document.getElementById('start-recording-btn').disabled = false;
            if (data.status === 'idle' && document.getElementById('recording-status').style.display !== 'none') {
                // Recording just finished
                showAlert('Recording completed! Refreshing list...', 'success');
                setTimeout(refreshRubix44List, 2000);
                document.getElementById('recording-status').style.display = 'none';
            }
        }
    } catch (error) {
        console.error('Error checking status:', error);
    }
}
</script>
{% endblock %}
